{
  "name": "agent-ready-boilerplate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#tooling/*": "./tooling/*"
  },
  "scripts": {
    "dev": "pnpm --filter @dev-template/config build && node tooling/dev.mjs",
    "build": "pnpm --filter @dev-template/config build && pnpm api:types && pnpm --filter @dev-template/api build && pnpm --filter @dev-template/web build && pnpm --filter @dev-template/business build && pnpm --filter @dev-template/admin build",
    "check": "pnpm --filter @dev-template/config build && vp check",
    "test": "vp test",
    "test:e2e": "vp exec playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter @dev-template/web typecheck && pnpm --filter @dev-template/business typecheck && pnpm --filter @dev-template/admin typecheck && pnpm --filter @dev-template/client typecheck && pnpm --filter @dev-template/api typecheck",
    "db:er": "pnpm --filter @dev-template/api db:er",
    "db:generate": "pnpm --filter @dev-template/api db:generate",
    "db:migrate:local": "pnpm --filter @dev-template/api db:migrate:local",
    "start": "corepack pnpm dev",
    "deploy": "pnpm --filter @dev-template/api deploy && pnpm --filter @dev-template/web deploy && pnpm --filter @dev-template/business deploy && pnpm --filter @dev-template/admin deploy",
    "deploy:preview": "node tooling/preview.mjs deploy",
    "format": "vp fmt",
    "hooks:install": "node .codex/scripts/setup-hooks.mjs",
    "test:harness": "node --test .codex/scripts/*.test.mjs",
    "dev:web": "pnpm --filter @dev-template/web dev",
    "dev:business": "pnpm --filter @dev-template/business dev",
    "dev:admin": "pnpm --filter @dev-template/admin dev",
    "dev:api": "pnpm --filter @dev-template/api dev",
    "db:seed:local": "pnpm --filter @dev-template/api db:seed:local",
    "access:bootstrap": "pnpm --filter @dev-template/api access:bootstrap",
    "preview:delete": "node tooling/preview.mjs delete",
    "deploy:api": "pnpm --filter @dev-template/api deploy",
    "db:preflight": "pnpm --filter @dev-template/api db:preflight",
    "db:migrate:remote": "pnpm --filter @dev-template/api db:migrate:remote",
    "api:types": "pnpm --filter @dev-template/api api:types --out ../../packages/api-types/index.d.ts && vp fmt packages/api-types/index.d.ts",
    "repository:export": "node tooling/export-repository.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test:stories": "vp test tests/storybook.test.tsx",
    "aliases:generate": "pnpm --filter @dev-template/client aliases:generate",
    "clerk:setup": "node tooling/setup-clerk.mjs",
    "typecheck:lint": "tsc --project tooling/lint/tsconfig.json"
  },
  "dependencies": {
    "@clerk/backend": "3.18.1",
    "@clerk/react": "6.16.1",
    "@dev-template/api-types": "workspace:*",
    "@dev-template/client": "workspace:*",
    "@dev-template/ui": "workspace:*",
    "@hono/trpc-server": "0.4.2",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@sentry/cloudflare": "11.0.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@dev-template/config": "workspace:*",
    "@juggle/resize-observer": "3.4.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.1",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "packageManager": "pnpm@11.21.0"
}
